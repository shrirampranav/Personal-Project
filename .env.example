# Copy to .env and edit. Never commit .env (it holds your broker credentials).

# Candle source: demo | yahoo | angelone
#   demo     - simulated market, replays a session outside market hours (no setup)
#   yahoo    - free NSE data via Yahoo Finance, no key, may lag ~1 min
#   angelone - real-time from your Angel One account via SmartAPI (credentials below)
DATA_PROVIDER=yahoo

# Option chain (OI, PCR, premiums): auto | nse | demo | off
OPTION_CHAIN_PROVIDER=auto

WATCHLIST=NIFTY,BANKNIFTY,RELIANCE,HDFCBANK,ICICIBANK,INFY,TCS,SBIN
REFRESH_SECONDS=30

# Risk rules
CAPITAL=200000
RISK_PER_TRADE_PCT=1
MAX_LOSING_TRADES=2
DAILY_LOSS_LIMIT=0
PREMIUM_STOP_PCT=30
VOLUME_MULT=1.5

# Angel One SmartAPI (https://smartapi.angelone.in -> create an app to get the API key)
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
# Base32 secret shown when enabling TOTP (not the 6-digit code)
ANGEL_TOTP_SECRET=

# Optional: Telegram alerts to your phone (create a bot with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
